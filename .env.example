PORT=8765
# Локально: 127.0.0.1. На VPS за reverse proxy часто: 127.0.0.1 (nginx проксирует).
BIND_HOST=127.0.0.1
# Обязательно смените перед деплоем. Не коммитьте .env.
ADMIN_PASSWORD=change-me
ADMIN_SECRET=change-me-too
# На HTTPS (nginx/caddy) cookie станет Secure автоматически по X-Forwarded-Proto.
# Принудительно: SECURE_COOKIES=1  |  отключить: SECURE_COOKIES=0
# SECURE_COOKIES=1

# CRM: резервные копии data/backups/crm-YYYYMMDD-HHMMSS.db
CRM_BACKUP_ON_START=1
CRM_BACKUP_INTERVAL_SEC=21600
CRM_BACKUP_KEEP=14

# AI consultant (optional). Without a key the local consultant still answers.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
# OPENAI_BASE_URL=https://api.openai.com/v1

# Seller requisites for invoice PDF (счёт-фактура). All required fields must be set
# or invoice download returns 400 listing what is missing — no placeholder values.
SELLER_NAME=
SELLER_BIN=
SELLER_ADDRESS=
SELLER_BANK=
SELLER_IIK=
SELLER_BIK=
SELLER_KBE=
# Optional:
SELLER_PHONE=
SELLER_TELEGRAM=
SELLER_DIRECTOR=
# 0 = Без НДС; 16 = НДС выделяется из цены (price × 16 / 116)
SELLER_VAT_RATE=0

