PORT=8765
# Локально / за nginx на хосте: 127.0.0.1.
# В Docker Compose BIND_HOST переопределяется на 0.0.0.0 — здесь можно не менять.
BIND_HOST=127.0.0.1

# PostgreSQL (обязательно). В Docker Compose web получает URL на сервис db автоматически;
# для локального python3 server.py укажите localhost и поднимите: docker compose up -d db
POSTGRES_USER=aigerim
POSTGRES_PASSWORD=change-me-db
POSTGRES_DB=aigerim_crm
DATABASE_URL=postgresql://aigerim:change-me-db@127.0.0.1:5432/aigerim_crm

# Обязательно: ADMIN_PASSWORD или ADMIN_PASSWORD_HASH. Без них сервер не стартует.
# На проде предпочтительно только хеш (plaintext в .env не нужен после первого хеширования):
#   python3 -c "import bcrypt; print(bcrypt.hashpw(b'YOUR_PASS', bcrypt.gensalt(rounds=12)).decode())"
# ADMIN_PASSWORD_HASH=$2b$12$...
ADMIN_PASSWORD=change-me
# ADMIN_PASSWORD_HASH=
# ADMIN_SECRET больше не используется для сессий (можно удалить).
# ADMIN_SECRET=
#
# Session cookie Secure flag:
# - Behind HTTPS reverse proxy: send X-Forwarded-Proto: https (auto Secure), OR
# - Set SECURE_COOKIES=1 on HTTPS prod. Do NOT set Secure if you still open the site over http.
# SECURE_COOKIES=1
#
# CSRF: allow www + apex (and any CDN host) if they differ from Host.
# Example: ALLOWED_ORIGINS=https://example.com,https://www.example.com
# Local Vite (localhost:5173) is allowlisted in code already.
# ALLOWED_ORIGINS=
#
# Peers allowed to send X-Real-IP / X-Forwarded-For (comma-separated). Default: localhost.
# TRUSTED_PROXIES=127.0.0.1,::1

# CRM: резервные копии data/backups/crm-YYYYMMDD-HHMMSS.json.gz
CRM_BACKUP_ON_START=1
CRM_BACKUP_INTERVAL_SEC=21600
CRM_BACKUP_KEEP=14

# AI consultant (optional). Without a key the local consultant still answers.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
# OPENAI_BASE_URL=https://api.openai.com/v1

# Seller requisites for invoice PDF (счёт-фактура). All required fields must be set
# or invoice download returns 400 listing what is missing — no placeholder values.
SELLER_NAME=
SELLER_BIN=
SELLER_ADDRESS=
SELLER_BANK=
SELLER_IIK=
SELLER_BIK=
SELLER_KBE=
# Required: must be set explicitly. Empty → invoice 400 (no silent default).
# 0 = Без НДС (так и пишется в счёте); 16 = НДС выделяется из цены (price × 16 / 116)
SELLER_VAT_RATE=0
# Optional:
SELLER_PHONE=
SELLER_TELEGRAM=
SELLER_DIRECTOR=
