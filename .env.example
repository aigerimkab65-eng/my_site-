PORT=8765
# Локально: 127.0.0.1. На VPS за reverse proxy часто: 127.0.0.1 (nginx проксирует).
BIND_HOST=127.0.0.1
# Обязательно: ADMIN_PASSWORD или ADMIN_PASSWORD_HASH. Без них сервер не стартует.
# Пароль в БД хранится только как bcrypt-хеш; plaintext из .env не логируется.
ADMIN_PASSWORD=change-me
# Либо готовый bcrypt-хеш (имеет приоритет над ADMIN_PASSWORD):
# ADMIN_PASSWORD_HASH=
# ADMIN_SECRET больше не используется для сессий (можно удалить).
# ADMIN_SECRET=
# На HTTPS (nginx/caddy) cookie станет Secure автоматически по X-Forwarded-Proto.
# Принудительно: SECURE_COOKIES=1  |  отключить: SECURE_COOKIES=0
# SECURE_COOKIES=1
# Peers allowed to send X-Real-IP / X-Forwarded-For (comma-separated). Default: localhost.
# TRUSTED_PROXIES=127.0.0.1,::1
# Пиры, от которых принимаются X-Real-IP / X-Forwarded-For для rate limits.
# По умолчанию уже доверяются 127.0.0.1 и ::1.
# TRUSTED_PROXIES=127.0.0.1,::1

# CRM: резервные копии data/backups/crm-YYYYMMDD-HHMMSS.db
CRM_BACKUP_ON_START=1
CRM_BACKUP_INTERVAL_SEC=21600
CRM_BACKUP_KEEP=14

# AI consultant (optional). Without a key the local consultant still answers.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
# OPENAI_BASE_URL=https://api.openai.com/v1

# Seller requisites for invoice PDF (счёт-фактура). All required fields must be set
# or invoice download returns 400 listing what is missing — no placeholder values.
SELLER_NAME=
SELLER_BIN=
SELLER_ADDRESS=
SELLER_BANK=
SELLER_IIK=
SELLER_BIK=
SELLER_KBE=
# Optional:
SELLER_PHONE=
SELLER_TELEGRAM=
SELLER_DIRECTOR=
# 0 = Без НДС; 16 = НДС выделяется из цены (price × 16 / 116)
SELLER_VAT_RATE=0
